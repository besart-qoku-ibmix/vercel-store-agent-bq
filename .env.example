# Copy to .env.local and fill in. Names and descriptions only: never commit real values.

# Vercel AI Gateway Authentication
# Choose one of the following authentication methods:

# Option 1: OIDC Token (recommended for local development)
# This is automatically generated when you run:
# vercel env pull
# VERCEL_OIDC_TOKEN=

# Option 2: API Key (for production or CI/CD)
# Create at: https://vercel.com/dashboard → AI Gateway → API Keys
# AI_GATEWAY_API_KEY=

# Optional: Override the default Vercel AI Gateway URL
# VERCEL_AI_GATEWAY_URL=

# Note: AI provider API keys (OpenAI, Anthropic, etc.) should be configured 
# in the Vercel Dashboard under AI Gateway → Integrations, not in this file


# --- Store API ---
# Base URL of the store API. Optional; defaults to https://vercel-agentic-swag-store-api.vercel.app/api
# API_BASE_URL=
# Deployment-protection bypass secret sent to the store API. Required.
# BYPASS_SECRET=

# --- Model provider (OpenAI-compatible, used by both agents) ---
# 
# CUSTOM_AI_BASE_URL=
# CUSTOM_AI_API_KEY=
# Defaults: gpt-6-luna (shopping agent), gpt-6.1-sol (admin agent).
# CUSTOM_AI_MODEL_LUNA=
# CUSTOM_AI_MODEL_SOL=

# --- Admin agent sandbox ---
# Local development only: run `vercel env pull` to fetch it (expires after ~12h).
# Vercel provides it automatically on deployments.
# VERCEL_OIDC_TOKEN=
# Name of the persistent Vercel Sandbox. Optional; defaults to ship-it-shop-admin
# ADMIN_SANDBOX_NAME=

# --- Misc ---
# Public site URL used for metadata. Optional; defaults to http://localhost:3000
# NEXT_PUBLIC_SITE_URL=
# VERCEL_PROJECT_PRODUCTION_URL=
